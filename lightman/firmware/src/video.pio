; @file video.pio
; @brief Stream packed HSYNC, VSYNC and RGB pixel bytes to five consecutive pins.
; @details Runs at 126 MHz with five cycles per pixel for a 25.2 MHz pixel clock.
; DMA feeds an eight-bit autopull; the three unused bits are discarded each pixel.
.program lightman_video
; 126 MHz / 5 = 25.2 MHz pixels. One byte encodes HS, VS, R, G, B.
; Eight-bit DMA writes replicate on the RP2040 peripheral bus. Autopull
; consumes exactly eight bits per pixel, including three discarded bits.
.wrap_target
    out pins, 5 [3]
    out null, 3
.wrap
